cabal-version: 3.0
name: sc-tools-browser
version: 0.1.0.0
build-type: Simple
license: Apache-2.0

executable sc-tools-browser
  main-is: Main.hs
  other-modules: MatchingNumber PortChecks LiveTx ExampleScripts LucidBalance LucidBridge Simulator
  hs-source-dirs: .
  default-language: Haskell2010
  default-extensions: ImportQualifiedPost
  ghc-options: -O1 -rtsopts -with-rtsopts=-K64m
  build-depends:
    base, data-default, aeson, scientific, bytestring, base16-bytestring, text, containers, mtl, contra-tracer,
    cardano-api, convex-base, convex-coin-selection, convex-mockchain,
    convex-wallet, convex-optics, plutus-core, plutus-ledger-api, serialise, cardano-binary, cardano-ledger-binary, cardano-ledger-core, cardano-ledger-shelley, cardano-ledger-conway, cardano-ledger-alonzo, cardano-slotting,
    ouroboros-consensus, sop-core, sop-extras, time, lens
